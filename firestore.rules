rules_version = '2';

// Pocket Hunter's cloud saves: one document per account (saves/{uid}), which only that account can read, write or
// delete. Paste into Firebase console → Firestore Database → Rules, and Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.savedAt is number;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
